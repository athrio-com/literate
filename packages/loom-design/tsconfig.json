{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "src/note.ts",
    "src/address.ts",
    "src/overlay.ts",
    "src/shell.ts",
    "src/ui.ts",
    "src/vite-env.d.ts"
  ]
}
