{
  "name": "@athrio/loom-design",
  "type": "module",
  "private": true,
  "version": "0.0.10",
  "scripts": {
    "dev": "bun build.ts --watch & builder=$!; trap 'kill $builder' EXIT; bun --watch src/design-serve.ts",
    "build": "bun build.ts",
    "serve": "bun src/serve.ts",
    "design": "bun src/design-serve.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "exports": {
    "./note": "./src/note.ts",
    "./design": "./src/design.ts",
    "./identity": "./src/identity.ts",
    "./store": "./src/store.ts"
  },
  "dependencies": {
    "foldkit": "workspace:*",
    "@effect/platform-browser": "4.0.0-beta.97",
    "@effect/platform-node": "4.0.0-beta.97",
    "@effect/sql-sqlite-bun": "4.0.0-beta.97",
    "@effect/sql-sqlite-node": "4.0.0-beta.97",
    "effect": "4.0.0-beta.97",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "@effect/platform-bun": "4.0.0-beta.97",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  }
}
